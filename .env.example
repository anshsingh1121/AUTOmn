# =====================================================================
# Change Management Audit Automation (CMAA) - Environment Configuration
# =====================================================================
# INSTRUCTIONS:
# 1. To use this file, copy or rename this file to '.env' in your project
#    or application folder (next to CMAA_Audit.exe or populate_cr_audit.py).
# 2. Fill in your ServiceNow details below.
# 3. The application will automatically detect and load these values,
#    bypassing the interactive credentials prompt on launch.
# =====================================================================

# Target ServiceNow Instance URL (HTTPS required)
# Format: https://<instance-name>.service-now.com
SN_INSTANCE_URL=https://your-company.service-now.com

# ServiceNow Corporate Account Username
# E.g. your corporate username (john.doe) or a dedicated audit service account
SN_USERNAME=your.username

# ServiceNow Corporate Password or API Token
# NOTE: Never commit actual passwords to version control (.env is in .gitignore)
SN_PASSWORD=your_password_here

# SSL Certificate Verification Setting:
# - 'false' : Skip SSL certificate verification (useful for internal corporate proxies with self-signed CAs)
# - 'true'  : Standard public SSL certificate verification (strict)
# - Path    : Full path to your corporate custom Root CA certificate bundle (.crt or .pem file)
#             Example: C:\Certs\CorporateRootCA.crt
SN_VERIFY_SSL=false
